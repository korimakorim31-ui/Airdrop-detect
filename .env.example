# Required for Telegram. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional. Comma-separated numeric Telegram user IDs. Empty = public.
ALLOWED_USER_IDS=

# Optional. Enables /ask and AI summaries. Get a key at https://console.x.ai
XAI_API_KEY=

# Optional model override. Default is grok-4.6
XAI_MODEL=grok-4.6

# Background watch. New CEX / airdrops are pushed automatically.
SCAN_INTERVAL_MINUTES=5
FIRST_SCAN_SECONDS=45
AUTO_PUSH=true

# Max individual pings per scan; more than this becomes one digest.
ALERT_NEW_LIMIT=5

# Daily best board size.
DAILY_PICK_LIMIT=10

# Supabase. Run supabase/schema.sql once in the SQL editor.
# Use the secret / service key (sb_secret_... or the old service_role JWT).
# Never use the publishable / anon key here. Never commit this file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
# SUPABASE_SECRET_KEY=   # also accepted (new dashboard name)
